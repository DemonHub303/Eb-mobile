task.spawn(function()
    local ESPStore = {}
    while task.wait(1) do
        if Config.npcESP then
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    if not ESPStore[obj] or not ESPStore[obj].Parent then
                        local hl = Instance.new("Highlight")
                        hl.Adornee = obj; hl.FillColor = Color3.fromRGB(255, 0, 255); hl.FillTransparency = 0.5
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = game.CoreGui; ESPStore[obj] = hl
                    end
                end
            end
            for model, hl in pairs(ESPStore) do
                if not model.Parent or not model:FindFirstChild("Humanoid") or model.Humanoid.Health <= 0 then
                    if hl then hl:Destroy() end; ESPStore[model] = nil
                end
            end
        else
            for model, hl in pairs(ESPStore) do if hl then hl:Destroy() end; ESPStore[model] = nil end
        end
    end
end)

