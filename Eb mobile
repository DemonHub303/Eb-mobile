-- LÓGICA DE TELEPORTE E INTERAÇÃO
-- ============================================================
local function Teleport(targetPart)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and targetPart then 
        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0) 
    end
end

local function InteractWithPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        pcall(function() fireproximityprompt(prompt) end)
    end
end

-- ============================================================
-- LOOP DO LIXO
-- ============================================================
task.spawn(function()
    local objetosIgnorados = {}
    while task.wait(1) do
        if Config.autoFarmLixo then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            
            local lixoPart, lixoPrompt = nil, nil
            local lixeiraPart, lixeiraPrompt = nil, nil
            local distMinLixo = math.huge
            
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled and (obj.ActionText:lower():find("recolher") or obj.ActionText:lower():find("lixo")) then
                    local parentPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                    if parentPart and not objetosIgnorados[parentPart] then
                        local d = (hrp.Position - parentPart.Position).Magnitude
                        if d < distMinLixo then distMinLixo = d; lixoPart = parentPart; lixoPrompt = obj end
                    end
                end
            end
            
            if lixoPart and lixoPrompt then
                objetosIgnorados[lixoPart] = true
                task.delay(15, function() objetosIgnorados[lixoPart] = nil end)
                
                Teleport(lixoPart)
                task.wait(0.5)
                InteractWithPrompt(lixoPrompt)
                task.wait(1)
                
                local distMinLixeira = math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Enabled and (obj.ActionText:lower():find("entregar") or obj.Parent.Name:lower():find("lixeira")) then
                        local parentPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                        if parentPart then
                            local d = (lixoPart.Position - parentPart.Position).Magnitude
                            if d < distMinLixeira then distMinLixeira = d; lixeiraPart = parentPart; lixeiraPrompt = obj end
                        end
                    end
                end
                if lixeiraPart and lixeiraPrompt then Teleport(lixeiraPart); task.wait(0.5); InteractWithPrompt(lixeiraPrompt); task.wait(1) end
            end
        end
    end
end)

-- ============================================================
-- LOOP DA CAIXA
-- ============================================================
local EstadoCaixa = "Procurar"
local TempoInicioEspera = 0

task.spawn(function()
    while task.wait(1) do
        if Config.autoFarmCaixa then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            
            if EstadoCaixa == "Procurar" then
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        local parentPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                        if parentPart and (obj.ActionText:lower():find("caixa") or obj.ActionText:lower():find("pegar") or obj.Parent.Name:lower():find("caixa")) then
                            
                            Teleport(parentPart)
                            task.wait(4) -- ESPERA 4 SEGUNDOS NA CAIXA
                            InteractWithPrompt(obj)
                            task.wait(1) 
                            
                            for _, objEntrega in pairs(workspace:GetDescendants()) do
                                if objEntrega:IsA("BasePart") or objEntrega:IsA("Model") then
                                    local nome = objEntrega.Name:lower()
                                    if nome:find("entrega") or nome:find("drop") or nome:find("delivery") or nome:find("zona") or nome:find("zone") then
                                        local targetEntrega = objEntrega:IsA("BasePart") and objEntrega or objEntrega:FindFirstChildWhichIsA("BasePart")
                                        if targetEntrega then
                                            Teleport(targetEntrega)
                                            task.wait(1) 
                                            for _, objPrompt in pairs(workspace:GetDescendants()) do
                                                if objPrompt:IsA("ProximityPrompt") and objPrompt.Enabled and (objPrompt.ActionText:lower():find("entregar") or objPrompt.ActionText:lower():find("depositar")) then
                                                    InteractWithPrompt(objPrompt); break
                                                end
                                            end
                                            EstadoCaixa = "Esperando"; TempoInicioEspera = tick(); break
                                        end
                                    end
                                end
                            end
                            break
                        end
                    end
                end
            elseif EstadoCaixa == "Esperando" then
                if (tick() - TempoInicioEspera) >= 29 then EstadoCaixa = "Procurar" end
            end
        else
            EstadoCaixa = "Procurar" 
        end
    end
end)

