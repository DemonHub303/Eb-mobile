-- LÓGICA DO AIMBOT (TOQUE NA TELA)
-- ============================================================
local aiming = false

-- Ativa ao tocar na tela
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    -- Se o input for um Toque (Touch) ou Botão do Mouse (para testar no PC)
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and Config.npcAimbot then 
        aiming = true 
    end
end)

-- Desativa ao soltar o dedo
UserInputService.InputEnded:Connect(function(input, gp)
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then 
        aiming = false 
    end
end)

RunService.RenderStepped:Connect(function()
    if not aiming or not Config.npcAimbot then return end
    
    local closest, dist = nil, 1000
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") then
            if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                local head = obj.Head
                local screenPoint = Camera:WorldToViewportPoint(head.Position)
                if screenPoint.Z > 0 then
                    local distCentro = math.sqrt((screenPoint.X - Camera.ViewportSize.X/2)^2 + (screenPoint.Y - Camera.ViewportSize.Y/2)^2)
                    if distCentro <= (Config.aimbotFOV / 2) then
                        local d = (Camera.CFrame.Position - head.Position).Magnitude
                        if d < dist then dist = d; closest = head end
                    end
                end
            end
        end
    end
    if closest then
        local targetPos = closest.Position
        local currentPos = Camera.CFrame.Position
        local newCFrame = CFrame.lookAt(currentPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.3) 
    end
end)

